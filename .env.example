# ============================================================================
# FlowSwap environment config — COPY this file to ".env" and fill in values.
# The real ".env" is git-ignored and must NEVER be committed or shared.
# ============================================================================

# --- RPC endpoints (free tier from alchemy.com or infura.io) ---
# Arbitrum One mainnet: used ONLY for LOCAL fork experiments (Phase 3).
#   Nothing here touches real funds — Anvil makes a private local copy.
ARBITRUM_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE"

# Arbitrum Sepolia testnet: used for the live testnet deploy (Phase 4).
ARBITRUM_SEPOLIA_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE"

# Zero-signup fallback public RPCs (rate-limited — fine to start, slower for forks):
#   ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
#   ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# --- Block-explorer API key (free from arbiscan.io) — verifies contracts in Phase 4 ---
ARBISCAN_API_KEY="YOUR_ARBISCAN_KEY_HERE"

# --- Deployer wallet PRIVATE KEY for testnet (Phase 4) ---
# Use a BRAND-NEW, DEV-ONLY wallet. NEVER paste a real/personal wallet key here.
# Leave blank for now.
PRIVATE_KEY=""
